{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "industry": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "mark_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "techniques": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "source": {
      "type": "string",
      "pattern": "\\S"
    },
    "rights": {
      "type": "string",
      "pattern": "\\S"
    },
    "observation": {
      "type": "string",
      "pattern": "\\S"
    },
    "storage": {
      "enum": [
        "owned",
        "licensed",
        "link-only"
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "name",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "logo.svg",
            "logo.png",
            "logo.jpg"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "required": [
    "id",
    "title",
    "industry",
    "mark_type",
    "techniques",
    "source",
    "rights",
    "observation",
    "storage"
  ],
  "additionalProperties": false
}
