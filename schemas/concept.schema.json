{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "visual_system": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tradeoffs": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "differentiation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "title",
    "rationale",
    "visual_system",
    "tradeoffs",
    "differentiation",
    "provenance"
  ],
  "additionalProperties": false
}
