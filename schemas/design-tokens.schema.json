{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "colors": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^#[0-9A-Fa-f]{6}$"
      }
    },
    "typography": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{0,79}$"
          },
          "fallback": {
            "enum": [
              "sans-serif",
              "serif",
              "monospace"
            ]
          },
          "weight": {
            "enum": [
              100,
              200,
              300,
              400,
              500,
              600,
              700,
              800,
              900
            ]
          },
          "rights": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "family",
          "fallback",
          "weight",
          "rights"
        ],
        "additionalProperties": false
      }
    },
    "contrast": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "foreground": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "background": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "usage": {
            "enum": [
              "normal-text",
              "large-text",
              "essential-ui",
              "logo-target"
            ]
          }
        },
        "required": [
          "foreground",
          "background",
          "usage"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "colors",
    "typography",
    "contrast"
  ],
  "additionalProperties": false
}
