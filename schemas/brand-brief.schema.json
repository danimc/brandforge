{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "positioning": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "promise": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "voice": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    }
  },
  "required": [
    "name",
    "slug",
    "category",
    "audience",
    "positioning",
    "promise",
    "evidence",
    "voice",
    "applications",
    "constraints"
  ],
  "additionalProperties": false
}
