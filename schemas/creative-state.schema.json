{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "brief_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "vector-first",
        "image-assisted",
        "hybrid"
      ]
    },
    "mode_reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "context": {
      "type": "string",
      "pattern": "\\S"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "brief",
              "research",
              "generated-image",
              "sketch"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          },
          "observation": {
            "type": "string",
            "pattern": "\\S"
          },
          "rights": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "kind",
          "source",
          "observation",
          "rights"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "pattern": "\\S"
          },
          "metaphor": {
            "type": "string",
            "pattern": "\\S"
          },
          "composition": {
            "type": "string",
            "pattern": "\\S"
          },
          "personality": {
            "type": "string",
            "pattern": "\\S"
          },
          "decision": {
            "enum": [
              "shortlisted",
              "discarded"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "metaphor",
          "composition",
          "personality",
          "decision",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 8,
      "maxItems": 12
    },
    "candidates": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30
      }
    },
    "grounds": {
      "type": "object",
      "properties": {
        "light": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "dark": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "light",
        "dark"
      ],
      "additionalProperties": false
    },
    "applications": {
      "type": "object",
      "properties": {
        "digital_title": {
          "type": "string",
          "pattern": "\\S"
        },
        "digital_copy": {
          "type": "string",
          "pattern": "\\S"
        },
        "print_title": {
          "type": "string",
          "pattern": "\\S"
        },
        "print_copy": {
          "type": "string",
          "pattern": "\\S"
        },
        "digital_label": {
          "type": "string",
          "pattern": "\\S"
        },
        "print_label": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "digital_title",
        "digital_copy",
        "print_title",
        "print_copy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "brief_sha256",
    "mode",
    "mode_reason",
    "context",
    "references",
    "hypotheses",
    "candidates",
    "grounds",
    "applications"
  ],
  "additionalProperties": false
}
