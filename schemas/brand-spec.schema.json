{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "brief_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "concept_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "concept_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "concept_approval": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "simulated": {
          "type": "boolean"
        }
      },
      "required": [
        "by",
        "date",
        "evidence",
        "simulated"
      ],
      "additionalProperties": false
    },
    "final_approval": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "date": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "simulated": {
              "type": "boolean"
            }
          },
          "required": [
            "by",
            "date",
            "evidence",
            "simulated"
          ],
          "additionalProperties": false
        },
        "review_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "decision",
        "review_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "revision",
    "brief_sha256"
  ],
  "additionalProperties": false
}
